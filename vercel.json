{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/editor", "destination": "/editor/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/editor/:path*", "destination": "https://zenvi-editor.vercel.app/editor/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
